{
  "name": "resume-orchestrator",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "bin": {
    "resume-orchestrator": "dist/cli.js"
  },
  "scripts": {
    "build": "tsup src/cli.ts src/graph/serve.ts --format esm --sourcemap --clean",
    "dev": "tsx src/cli.ts",
    "graphql:serve": "tsx src/graph/serve.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "commander": "12.1.0",
    "fast-glob": "3.3.2",
    "graphql": "16.9.0",
    "graphql-yoga": "5.10.4",
    "gray-matter": "4.0.3",
    "mustache": "4.2.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/mustache": "4.2.5",
    "@types/node": "22.10.5",
    "tsup": "8.3.5",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
