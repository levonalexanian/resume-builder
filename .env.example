# Copy to `.env` in the repo root. Real keys stay local; this file is the committed template.
# Loaded by the orchestrator (tools/orchestrator) from repo root.

# ---------------------------------------------------------------------------
# Database (Postgres)
# ---------------------------------------------------------------------------
# docker-compose.yml already exports DATABASE_URL inside the dev container.
# Override here only when running the backend or the import script outside
# the dev container.
# DATABASE_URL=postgresql+asyncpg://resume:resume@postgres:5432/resume

# ---------------------------------------------------------------------------
# Provider API keys (optional — leave empty if that step is manual / human-in-the-loop)
# ---------------------------------------------------------------------------
PERPLEXITY_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# ---------------------------------------------------------------------------
# Step toggles: when a flag is false, the pipeline must NOT call that provider;
# it should emit a stub artifact, print next steps, or block until human input.
# Parse as boolean: true | 1 | yes | on (case-insensitive) = on; anything else = off.
# When a toggle is on but its key is missing, the CLI fails fast.
# ---------------------------------------------------------------------------

# Step 1: company/role research via Perplexity. If false: skip HTTP and emit a
# `job_analysis.MANUAL.md` prompt for the user to fill `job_analysis.json` by hand.
RESUME_USE_PERPLEXITY_RESEARCH=false

# Step 3: optional LLM re-rank on top of deterministic relevancy + freshness.
# Off by default; current implementation logs a warning if turned on without
# additional wiring.
RESUME_USE_LLM_RERANK=false

# Step 4: LLM draft of `resume.tex`. If false: emit `resume.prompt.md` for the
# user to author the LaTeX manually, then run `latex_to_pdf` to compile.
RESUME_USE_LLM_DRAFT=false

# Step 4 provider selection. One of: openai | anthropic | google.
# Only consulted when RESUME_USE_LLM_DRAFT=true.
RESUME_DRAFT_PROVIDER=openai
